[user]
	name = J Laxson
	email = jackjrabbit@gmail.com
	signingkey = 22372004
[help]
    autocorrect = 5
[push]
	simple = simple
[core]
	editor = micro
	excludesfile = /home/jack/.gitignore_global
	autocrlf = input
[init]
	defaultBranch = dev
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[color]
	ui = auto
